# Copy to `.env` in the project root (next to package.json). Never commit real keys.

# Use ONE of these (not both required). If you only set CLAUDE_API_KEY, ANTHROPIC_API_KEY
# will be undefined in process.env — that is expected; the server reads either.
CLAUDE_API_KEY=
# ANTHROPIC_API_KEY=

CLAUDE_MODEL=claude-3-5-sonnet-latest
PORT=8787

# Optional: .env.local overrides .env (gitignore it)
# VITE_CHAT_API_URL=
